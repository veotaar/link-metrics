{
  "name": "@link-metrics/nest-node",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS with Express on Node.js Contender for Link Metrics",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check-types": "tsc --project tsconfig.json --noEmit",
    "db:introspect": "drizzle-kit pull --config drizzle.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.11",
    "@nestjs/core": "11.1.11",
    "@nestjs/platform-express": "11.1.11",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
