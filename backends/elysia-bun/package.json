{
  "name": "@link-metrics/elysia-bun",
  "version": "1.0.0",
  "private": true,
  "description": "Elysia on Bun Contender for Link Metrics",
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "check-types": "tsc --project tsconfig.json --noEmit",
    "db:introspect": "drizzle-kit pull --config drizzle.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
