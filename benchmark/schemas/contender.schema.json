{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://link-metrics.local/schemas/contender.schema.json",
  "title": "Link Metrics Contender manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "apiContractVersion",
    "language",
    "runtime",
    "framework",
    "container",
    "port",
    "workers",
    "resourceProfile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "apiContractVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "language": {
      "$ref": "#/$defs/versionedComponent"
    },
    "runtime": {
      "$ref": "#/$defs/versionedComponent"
    },
    "framework": {
      "$ref": "#/$defs/versionedComponent"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "dockerfile"],
      "properties": {
        "context": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "dockerfile": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "count"],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resourceProfile": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
